-- виртуальная поправка 
insert into temp_correction(t0, delta_tv) values
(0,  0.5),
(5,  0.5),
(10, 1),
(15, 1),
(20, 1.5),
(25, 2),
(30, 3.5),
(40, 4.5);

commit;

alter table ranks
alter column rank set not null;

alter table devices
alter column name set not null;

alter table soldiers
alter column personal_id set not null,
alter column rank_id set not null,
add constraint fk_soldiers_ranks foreign key (rank_id) references ranks(id);

alter table base_unit_meas
alter column name set not null;

alter table unit_meas
alter column name set not null,
alter column base_id set not null,
alter column factor set not null,
add constraint fk_unit_meas_base_unit_meas foreign key (base_id) references base_unit_meas(id);

alter table type_parameter
alter column name set not null;

alter table parameters
alter column type_par_id set not null,
alter column batch_id set not null,
alter column unit_meas_id set not null,
alter column value set not null,
add constraint fk_parameter_type_parameter foreign key (type_par_id) references type_parameter(id),
add constraint fk_parameter_batch_id foreign key (batch_id) references batch(id),
add constraint fk_parameter_unit_meas foreign key (unit_meas_id) references unit_meas(id);

alter table batch
alter column soldier_id set not null,
alter column device_id set not null,
alter column measured_at set not null,
add constraint fk_batch_soldiers foreign key (soldier_id) references soldiers(id),
add constraint fk_batch_devices foreign key (device_id) references devices(id);

alter table temp_correction
alter column t0 set not null,
alter column delta_tv set not null;

commit;

end
$$;