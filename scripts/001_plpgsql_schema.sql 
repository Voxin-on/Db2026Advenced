    ('Давление'),
    ('Направление ветра'),
    ('Скорость ветра'),
    ('Дальность сноса пуль');

-- =========================================================
-- 7. batch — 6 солдат × 4 пачки = 24 записи
--    device_id: 1 = ДМК, 2 = ВР
--    measured_at уникальны
-- =========================================================
insert into batch(soldier_id, device_id, measured_at) values
    -- солдат 1 (ДМК)
    (1, 1, '2025-01-01 08:00:00+03'),
    (1, 1, '2025-01-01 09:00:00+03'),
