    -- солдат 4 (ВР)
    (4, 2, '2025-01-04 08:00:00+03'),
    (4, 2, '2025-01-04 09:00:00+03'),
    (4, 2, '2025-01-04 10:00:00+03'),
    (4, 2, '2025-01-04 11:00:00+03'),
    -- солдат 5 (ДМК)
    (5, 1, '2025-01-05 08:00:00+03'),
    (5, 1, '2025-01-05 09:00:00+03'),
    (5, 1, '2025-01-05 10:00:00+03'),
    (5, 1, '2025-01-05 11:00:00+03'),
    -- солдат 6 (ВР)
    (6, 2, '2025-01-06 08:00:00+03'),
    (6, 2, '2025-01-06 09:00:00+03'),
    (6, 2, '2025-01-06 10:00:00+03'),
    (6, 2, '2025-01-06 11:00:00+03');

-- =========================================================
-- 8. parameters — параметры измерений
--    type_par_id:
--      1 = Высота метеопоста   (unit 1, метр над уровнем моря, целые, могут быть отриц.)
--      2 = Температура         (unit 2, °C, дробные с 1 знаком, -58..58)
--      3 = Давление            (unit 3, мм рт.ст., целые >0, 500..900)
--      4 = Направление ветра   (unit 4, БДУ, 2 разряда, 0..59)
--      5 = Скорость ветра      (unit 5, м/с, целые >=0, 0..15) — для ДМК
--      6 = Дальность сноса пуль(unit 1, м, целые >=0, 0..150) — для ВР
-- =========================================================

-- ---- Пачки с ДМК (device_id = 1): параметры 1,2,3,4,5 ----
-- batch 1..4 (солдат 1), 9..12 (солдат 3), 17..20 (солдат 5)

-- batch 1
insert into parameters(batch_id, type_par_id, unit_meas_id, value) values
    (1, 1, 1, 150),
